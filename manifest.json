{
  "manifest_version": 3,
  "name": "TimeTrack",
  "version": "1.0",
  "description": "Automatically track active time spent on websites. All data stored locally.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
